{
	"schemaVersion": 1,
	"id": "dropallplus",
	"version": "${version}",
	"name": "Inventory Drop All",
	"description": "A button in every inventory screen that drops your whole inventory including the hotbar. Armor and locked slots stay.",
	"authors": [
		"Lennard"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.lennard.dropall.DropAllMod"
		],
		"modmenu": [
			"de.lennard.dropall.ModMenuIntegration"
		]
	},
	"mixins": [
		"dropallplus.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~${mc}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
